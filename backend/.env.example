# ================================================
# SafeHike Backend — Environment Configuration
# ================================================
# Salin file ini menjadi .env dan sesuaikan nilainya

# --- Database (PostgreSQL) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://safehike:safehike123@localhost:5432/safehike

# --- Keamanan JWT ---
SECRET_KEY=supersecretkey-safehike-2024-changeme-in-production

# --- CORS ---
# Pisahkan beberapa origin dengan koma. Untuk Vercel, gunakan domain frontend production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Google Gemini AI ---
# Dapatkan API Key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
